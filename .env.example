# Inkgauge AI Configuration
# NOTE: Inkgauge includes a built-in Local AI Engine that runs 100% free and offline
# with ZERO API keys needed! The keys below are entirely optional.

# Optional: Google Gemini API (has a generous free tier)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Local Ollama endpoint (free local LLMs like llama3.2, mistral, gemma2)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional: Anthropic Claude API
ANTHROPIC_API_KEY=
INKGAUGE_FAST_MODEL=claude-haiku-5-5
INKGAUGE_DEEP_MODEL=claude-sonnet-5-5
